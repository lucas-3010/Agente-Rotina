# Copie para .env.local e preencha. Nunca comite o .env.local.
# O passo a passo de onde tirar cada valor está em docs/instalacao.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
EMAIL_REMETENTE=Agente de rotina <onboarding@resend.dev>

# O único email que pode entrar no site.
EMAIL_PERMITIDO=

# Protege as rotas do agendador. Gere com: openssl rand -hex 32
CRON_SECRET=

# Opcional: só para ler convites que vêm sem arquivo .ics.
ANTHROPIC_API_KEY=
